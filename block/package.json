{
  "name": "@platforma-open/milaboratories.repertoire-distance-2",
  "version": "2.4.1",
  "files": [
    "dist",
    "block-pack"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "sources": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "pretty": "prettier --write \"./**/*.{js,jsx,mjs,cjs,ts,tsx,json,vue}\"",
    "build": "ts-builder build --target block-facade && block-tools pack",
    "mark-stable": "block-tools mark-stable -r 's3://milab-euce1-prod-pkgs-s3-block-registry/pub/releases/?region=eu-central-1'",
    "prepublishOnly": "block-tools publish -r s3://milab-euce1-prod-pkgs-s3-block-registry/pub/releases/?region=eu-central-1 --registry-serve-url https://blocks.pl-open.science",
    "do-pack": "shx rm -f package.tgz && pnpm pack && shx mv *.tgz package.tgz",
    "check": "ts-builder type-check --target block-facade"
  },
  "dependencies": {},
  "devDependencies": {
    "@milaboratories/ts-builder": "catalog:",
    "@milaboratories/ts-configs": "catalog:",
    "@platforma-open/milaboratories.repertoire-distance-2.kind": "workspace:*",
    "@platforma-open/milaboratories.repertoire-distance-2.model": "workspace:*",
    "@platforma-open/milaboratories.repertoire-distance-2.ui": "workspace:*",
    "@platforma-open/milaboratories.repertoire-distance-2.workflow": "workspace:*",
    "@platforma-sdk/block-tools": "catalog:",
    "@platforma-sdk/model": "catalog:",
    "shx": "catalog:",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@9.12.0",
  "block": {
    "components": {
      "workflow": "@platforma-open/milaboratories.repertoire-distance-2.workflow/dist/tengo/tpl/main.plj.gz",
      "model": "@platforma-open/milaboratories.repertoire-distance-2.model/dist/model.json",
      "ui": "@platforma-open/milaboratories.repertoire-distance-2.ui/dist"
    },
    "meta": {
      "title": "Distance Analysis",
      "logo": "file:../logos/block-logo.png",
      "url": "https://github.com/platforma-open/repertoire-distance",
      "support": "mailto:support@milaboratories.com",
      "description": "Calculates pairwise similarity distances between clonotype or peptide repertoires using configurable overlap metrics (F1, F2, Jaccard, correlation) to compare composition across samples.",
      "longDescription": "file:../docs/description.md",
      "changelog": "file:../CHANGELOG.md",
      "tags": [
        "repertoire",
        "distance",
        "similarity",
        "peptide"
      ],
      "organization": {
        "name": "MiLaboratories Inc",
        "url": "https://milaboratories.com/",
        "logo": "file:../logos/organization-logo.png"
      }
    }
  }
}
